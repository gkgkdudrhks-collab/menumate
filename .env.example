# ==========================================
# MenuMate Vercel 환경 변수 설정 예시 (.env.example)
# Vercel 프로젝트 Settings > Environment Variables 에 등록하세요.
# ==========================================

# 1. Supabase Cloud DB 설정 (선택 또는 필수)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 2. Google Gemini LLM API 설정 (선택 - 미설정 시 내장 불호방어 알고리즘 자동 작동)
GEMINI_API_KEY=your_gemini_api_key_here
