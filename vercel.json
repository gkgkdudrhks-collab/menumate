{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/menumate_v2.html"
    },
    {
      "src": "/v2",
      "dest": "/menumate_v2.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
